VERSION=5.0.0-dev
MTX_TAG=1.16.3
MTX_API=true
IOS_VERSION=17.7.2
APP_VERSION=3.5.5.8
HL_CAM4_MAIN_PROBE_MODE=kvs
WHEP_PROXY_PORT=18080
KVS_CONFIG_PORT=55000
WB_APP_PORT=55000
SDK_KEY=SDK_KEY_REPLACED_ROTATE_YOUR_KEY
MTX_APIADDRESS=:29997
MTX_HLSADDRESS=:28888
MTX_METRICSADDRESS=:29998
MTX_PLAYBACKADDRESS=:29996
MTX_PPROFADDRESS=:29999
MTX_RTCPADDRESS=:28001
MTX_RTMPADDRESS=:21935
MTX_RTMPSADDRESS=:21936
MTX_RTPADDRESS=:28000
MTX_RTSPADDRESS=:28554
MTX_RTSPSADDRESS=:28322
MTX_SRTADDRESS=:28890
MTX_WEBRTCADDRESS=:28889
MTX_WEBRTCLOCALUDPADDRESS=:28189
GO2RTC_RTSP_PORT=8554

# Babysitter (non-secret config; passwords set via /babysitter settings page at runtime)
ENABLE_BABYSITTER=true
SCRYPTED_HOST=https://<example>:10443
SCRYPTED_USERNAME=<example>
FRIGATE_HOST=http://<example-frigate>:5000
MQTT_BROKER=<example>
MQTT_PORT=1883
MQTT_USERNAME=<example>
REOLINK_USERNAME=<example>
# BABYSIT_CAMERAS format: <alias>:<channel>:<ip>:[<native_alias>], e.g. front_door:0:192.0.2.10:
BABYSIT_CAMERAS=
# Additional cameras previously configured here were unplugged 2026-06-27
# BABYSIT_APPROVED_CAMERAS format: comma-separated aliases, e.g. front_door,side_gate
BABYSIT_APPROVED_CAMERAS=
BABYSIT_DRY_RUN=false
BABYSIT_INTERVAL=30
BABYSIT_VIDEO_DOWN_THRESHOLD=60
BABYSIT_COOLDOWN=300
BABYSIT_MAX_DAILY=5
