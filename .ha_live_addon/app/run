#!/bin/sh

if [ -f /app/.env ]; then
    set -a
    # shellcheck disable=SC1091
    . /app/.env
    set +a
fi

if [ "$BUILD" = "dev" ]; then
    echo "[RUN] Development build enabled; raw add-on options are not printed."
fi

start_whep_proxy() {
    if command -v whep_proxy >/dev/null 2>&1; then
        whep_port="${WHEP_PROXY_PORT:-8080}"
        whep_port_is_open() {
            python3 - "$1" <<'PY'
import socket
import sys

port = int(sys.argv[1])
sock = socket.socket()
sock.settimeout(1)
try:
    sock.connect(("127.0.0.1", port))
except OSError:
    raise SystemExit(1)
finally:
    sock.close()
PY
        }

        if whep_port_is_open "$whep_port"; then
            echo "[WHEP_PROXY] Existing listener detected on 127.0.0.1:${whep_port}; not starting a duplicate." >&2
            return
        fi
        if command -v ps >/dev/null 2>&1; then
            for pid in $(ps | awk '/[s]h -c/ && /whep_proxy/ {print $1}'); do
                kill "$pid" 2>/dev/null || true
            done
        fi
        if command -v pkill >/dev/null 2>&1; then
            pkill -f '[w]hep_proxy >>/tmp/whep_proxy.log' 2>/dev/null || true
            pkill -x whep_proxy 2>/dev/null || true
        elif command -v pidof >/dev/null 2>&1; then
            # shellcheck disable=SC2046
            kill $(pidof whep_proxy) 2>/dev/null || true
        fi
        sleep 1
        if whep_port_is_open "$whep_port"; then
            echo "[WHEP_PROXY] Reusing listener on 127.0.0.1:${whep_port} after cleanup." >&2
            return
        fi
        nohup sh -c '
            while :; do
                whep_proxy >>/tmp/whep_proxy.log 2>&1
                status=$?
                printf "%s whep_proxy exited with status %s\n" "$(date -Iseconds)" "$status" >>/tmp/whep_proxy.log
                sleep 2
            done
        ' </dev/null >/dev/null 2>&1 &
    fi
}

start_whep_proxy

# Load HA options into environment before sidecar starts.
# setup_hass() in hass.py does this for the Flask app, but the go2rtc
# sidecar starts before Flask and needs WYZE_EMAIL/WYZE_PASSWORD.
if [ -f /data/options.json ] && [ -n "${SUPERVISOR_TOKEN:-}" ]; then
    for key in WYZE_EMAIL WYZE_PASSWORD API_ID API_KEY; do
        val=$(python3 -c "import json; print(json.load(open('/data/options.json')).get('$key',''))" 2>/dev/null || echo "")
        if [ -n "$val" ]; then
            export "$key=$val"
        fi
    done
fi
# Fallback: if Supervisor options are missing (stale schema cache), read
# credentials from the persistent /config mount.
if [ -z "${WYZE_EMAIL:-}" ] && [ -f /config/wyze_credentials.json ]; then
    echo "[RUN] Loading Wyze credentials from /config fallback" >&2
    for key in WYZE_EMAIL WYZE_PASSWORD API_ID API_KEY; do
        val=$(python3 -c "import json; print(json.load(open('/config/wyze_credentials.json')).get('$key',''))" 2>/dev/null || echo "")
        if [ -n "$val" ]; then
            export "$key=$val"
        fi
    done
fi

# Overlay: if updated sidecar/helpers exist in the persistent /config mount,
# validate them before replacing baked-in files. A malformed persistent shell
# overlay must never make an otherwise-good add-on fail during `. sidecar.sh`.
if [ -f /config/go2rtc_sidecar.sh ]; then
    if sh -n /config/go2rtc_sidecar.sh 2>/tmp/go2rtc_sidecar_overlay_syntax.log; then
        echo "[RUN] Overlay: applying validated sidecar from /config" >&2
        cp /config/go2rtc_sidecar.sh /app/go2rtc_sidecar.sh
        chmod +x /app/go2rtc_sidecar.sh
    else
        echo "[RUN] WARNING: rejected invalid /config/go2rtc_sidecar.sh; using baked-in sidecar" >&2
        cat /tmp/go2rtc_sidecar_overlay_syntax.log >&2 2>/dev/null || true
    fi
fi
if [ -f /config/go2rtc_sidecar_helpers.py ]; then
    if python3 -m py_compile /config/go2rtc_sidecar_helpers.py 2>/tmp/go2rtc_helpers_overlay_syntax.log; then
        cp /config/go2rtc_sidecar_helpers.py /app/wyzebridge/go2rtc_sidecar_helpers.py
    else
        echo "[RUN] WARNING: rejected invalid /config/go2rtc_sidecar_helpers.py; using baked-in helpers" >&2
        cat /tmp/go2rtc_helpers_overlay_syntax.log >&2 2>/dev/null || true
    fi
fi

if ! sh -n /app/go2rtc_sidecar.sh; then
    echo "[RUN] FATAL: baked-in go2rtc_sidecar.sh failed shell syntax validation" >&2
    exit 1
fi

. /app/go2rtc_sidecar.sh
start_go2rtc_sidecar

export PYTHONPATH="/app${PYTHONPATH:+:$PYTHONPATH}"

# Producer bytes and an RTSP 200 response are not sufficient proof that a new
# consumer can decode H.264. This watchdog validates RTSP SDP plus a decoded
# JPEG frame and performs bounded alias/process recovery when that path fails.
python3 -m wyzebridge.go2rtc_consumer_health &

exec flask run --host=0.0.0.0 --port="${WB_APP_PORT:-5000}"
